{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/chat", "destination": "/api/index" },
    { "source": "/lead", "destination": "/api/index" },
    { "source": "/admin/:path*", "destination": "/api/index" }
  ]
}
